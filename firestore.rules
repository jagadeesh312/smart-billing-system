rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function myDoc() {
      return userDoc(request.auth.uid);
    }

    function isAdmin() {
      return isSignedIn() && myDoc().data.role == "admin";
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasAdminParticipant(participants) {
      return participants.size() == 2
        && participants[0] != participants[1]
        && (
          userDoc(participants[0]).data.role == "admin"
          || userDoc(participants[1]).data.role == "admin"
        );
    }

    function isChatParticipant(chatId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    match /users/{uid} {
      allow read: if isAdmin() || isSelf(uid);

      allow create: if isAdmin()
        || (
          isSelf(uid)
          && request.resource.data.role == "user"
          && request.resource.data.blocked == false
        );

      allow update: if isAdmin()
        || (
          isSelf(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.blocked == resource.data.blocked
        );

      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.participants);

      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && hasAdminParticipant(request.resource.data.participants);

      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid in resource.data.participants
          && request.resource.data.participants == resource.data.participants
          && hasAdminParticipant(request.resource.data.participants)
        );

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || isChatParticipant(chatId);

        allow create: if (isAdmin() || isChatParticipant(chatId))
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;

        allow update: if isAdmin()
          || (
            isChatParticipant(chatId)
            && request.resource.data.senderId == resource.data.senderId
            && request.resource.data.timestamp == resource.data.timestamp
            && (
              request.auth.uid == resource.data.senderId
              || (
                request.resource.data.text == resource.data.text
                && request.resource.data.edited == resource.data.edited
              )
            )
          );

        allow delete: if isAdmin();
      }
    }
  }
}
